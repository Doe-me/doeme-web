# Docker Environment Variables

# API Configuration
API_URL=http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Reverb (WebSocket) Configuration - precisa bater com REVERB_* da API
VITE_REVERB_APP_KEY=doeme-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# App Configuration
VITE_APP_NAME=Doe Me
VITE_APP_DESCRIPTION=Plataforma de doações entre pessoas

# Development Configuration
NODE_ENV=development
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000

# Production Configuration (uncomment for production)
# NODE_ENV=production
# API_URL=https://api.doeme.com/api
# VITE_API_URL=https://api.doeme.com/api

