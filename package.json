{
  "name": "doe-me-app",
  "version": "1.0.0",
  "description": "Aplicação web híbrida para doações - conecte doadores e beneficiários de forma simples e segura",
  "private": true,
  "type": "module",
  "author": "Doe Me Team",
  "license": "MIT",
  "homepage": "https://doeme.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/doe-me-app.git"
  },
  "bugs": {
    "url": "https://github.com/user/doe-me-app/issues"
  },
  "keywords": [
    "vue",
    "typescript",
    "pwa",
    "donations",
    "charity",
    "mobile-app",
    "tailwindcss"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "clean": "rm -rf dist node_modules/.vite",
    "analyze": "vite build --mode analyze",
    "serve": "vite preview --port 4173",
    "docker:build": "docker build -t doe-me-app .",
    "docker:run": "docker run -p 80:80 doe-me-app",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "capacitor:init": "npx cap init",
    "capacitor:add:android": "npx cap add android",
    "capacitor:add:ios": "npx cap add ios",
    "capacitor:sync": "npx cap sync",
    "capacitor:build": "npm run build && npx cap sync",
    "capacitor:android": "npx cap open android",
    "capacitor:ios": "npx cap open ios",
    "pwa:build": "vite build --mode pwa",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "health-check": "curl -f http://localhost:4173/api/health || exit 1",
    "postinstall": "husky install || true",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@vueuse/core": "^13.6.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "laravel-echo": "^2.3.7",
    "pinia": "^3.0.3",
    "postcss": "^8.5.6",
    "pusher-js": "^8.5.0",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "typescript": "~5.8.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  }
}
